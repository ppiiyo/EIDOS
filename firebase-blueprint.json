{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with authentication details and settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 255 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "tier": { "type": "string", "enum": ["free", "business", "enterprise"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "EIDOS semantic ideation project with concepts and parameters.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "concepts": { "type": "array" },
        "simThreshold": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "userId", "concepts", "createdAt"]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "Item in the semantic recommender catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "numericId": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 100 },
        "price": { "type": "string", "maxLength": 50 },
        "tags": { "type": "array" },
        "icon": { "type": "string", "maxLength": 20 },
        "userId": { "type": "string", "maxLength": 128 },
        "custom": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description", "category", "userId", "createdAt"]
    },
    "ApiKey": {
      "title": "ApiKey",
      "description": "Generated API key for programmatic EIDOS access.",
      "type": "object",
      "properties": {
        "keyId": { "type": "string", "maxLength": 128 },
        "keyPrefix": { "type": "string", "maxLength": 30 },
        "tier": { "type": "string", "enum": ["Free", "Business", "Enterprise"] },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["keyId", "userId", "tier", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile data, accessible only by the owner."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Ideation projects owned by the user."
    },
    "/users/{userId}/catalog/{itemId}": {
      "schema": { "$ref": "#/entities/CatalogItem" },
      "description": "Customized catalog items owned by the user."
    },
    "/users/{userId}/keys/{keyId}": {
      "schema": { "$ref": "#/entities/ApiKey" },
      "description": "API keys generated by the user."
    }
  }
}
