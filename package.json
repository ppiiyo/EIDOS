{
  "name": "eidos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "EIDOS — Production Semantic Recommender & Ideation Engine",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "turbo run clean && rm -rf node_modules",
    "seed": "tsx scripts/seed-catalog.ts",
    "embeddings:generate": "tsx scripts/generate-embeddings.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "turbo": "^2.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
