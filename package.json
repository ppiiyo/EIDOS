{
  "name": "eidos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "EIDOS — Production Semantic Recommender & Ideation Engine",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "turbo run clean && rm -rf node_modules",
    "seed": "tsx scripts/seed-catalog.ts",
    "embeddings:generate": "tsx scripts/generate-embeddings.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "turbo": "^2.4.0",
    "typescript": "~5.8.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
