{
  "name": "eidos",
  "version": "1.0.0",
  "private": true,
  "description": "Eidos — Production Semantic Recommender & Ideation Engine",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node -e \"process.exit(process.env.CI === 'true' ? 1 : 0)\" || npx only-allow pnpm",
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build --config apps/workspace/vite.config.ts",
    "preview": "vite preview --config apps/workspace/vite.config.ts --port=3000",
    "lint": "tsc --noEmit && tsc -p packages/core/tsconfig.json --emitDeclarationOnly && tsc -p packages/sdk/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "typecheck": "npm run lint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:check": "vitest run packages/core/src/tests/security-guardrails.test.ts apps/api/tests/hnsw-store-security.test.ts apps/api/tests/production-hardening.test.ts tests/unit/architecture-constraints.test.ts",
    "clean": "rm -rf dist node_modules .turbo packages/*/dist apps/*/dist coverage benchmark-results.json",
    "embeddings:generate": "tsx scripts/generate-embeddings.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:integration": "tsx scripts/test-real-integration.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@xenova/transformers": "^2.17.2",
    "fake-indexeddb": "^6.2.6",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.546.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "turbo": "^2.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=7.6.1"
    }
  },
  "overrides": {
    "protobufjs": ">=7.6.1"
  },
  "packageManager": "pnpm@9.15.4"
}
