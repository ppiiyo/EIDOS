{
  "name": "eidos",
  "version": "3.4.0",
  "private": true,
  "description": "Eidos v3.4 — Enterprise Hybrid Search, 7-Component Explainable X-Ray, Distributed HNSW Sharding & Adaptive Recommendation Engine",
  "workspaces": [
    "apps/api",
    "apps/workspace",
    "packages/core",
    "packages/sdk"
  ],
  "scripts": {
    "preinstall": "node -e \"process.exit(0)\" || npx only-allow pnpm",
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "tsc -p packages/core/tsconfig.json && vite build --config apps/workspace/vite.config.ts",
    "preview": "vite preview --config apps/workspace/vite.config.ts --port=3000",
    "lint": "tsc --noEmit && tsc -p packages/core/tsconfig.json --emitDeclarationOnly && tsc -p packages/sdk/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "typecheck": "npm run lint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:check": "vitest run packages/core/src/tests/security-guardrails.test.ts apps/api/tests/hnsw-store-security.test.ts apps/api/tests/production-hardening.test.ts tests/unit/architecture-constraints.test.ts",
    "clean": "rm -rf dist node_modules .turbo packages/*/dist apps/*/dist coverage benchmark-results.json",
    "embeddings:generate": "tsx scripts/generate-embeddings.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:cache": "tsx scripts/benchmark-cache.ts",
    "test:integration": "tsx scripts/test-real-integration.ts",
    "data:seed": "tsx scripts/seed-demo-data.ts",
    "loadtest:setup": "cd load-testing/monitoring && docker-compose up -d",
    "loadtest:baseline": "k6 run --out prometheus=http://localhost:9090/api/v1/write load-testing/scripts/baseline.js",
    "loadtest:stress": "k6 run --out prometheus=http://localhost:9090/api/v1/write load-testing/scripts/stress.js",
    "loadtest:spike": "k6 run --out prometheus=http://localhost:9090/api/v1/write load-testing/scripts/spike.js",
    "loadtest:soak": "k6 run --out prometheus=http://localhost:9090/api/v1/write load-testing/scripts/soak.js",
    "loadtest:analyze": "chmod +x load-testing/scripts/analyze-results.sh && ./load-testing/scripts/analyze-results.sh",
    "loadtest:report": "node load-testing/scripts/generate-report.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xenova/transformers": "^2.17.2",
    "fake-indexeddb": "^6.2.6",
    "fastify": "^4.26.2",
    "idb-keyval": "^6.3.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tsx": "^4.21.0",
    "vite": "^6.4.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^2.1.8",
    "turbo": "^2.4.0",
    "typescript": "~5.8.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "onnxruntime-node"
    ],
    "overrides": {
      "protobufjs": ">=7.6.1",
      "sharp": "^0.33.5"
    }
  },
  "overrides": {
    "protobufjs": ">=7.6.1",
    "sharp": "^0.33.5"
  },
  "packageManager": "pnpm@9.15.4"
}
