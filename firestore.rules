rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && incoming().uid == userId;
      allow update: if isOwner(userId) && incoming().uid == userId;
      allow delete: if false;

      // Projects subcollection
      match /projects/{projectId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(projectId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      // Catalog items subcollection
      match /catalog/{itemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(itemId) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(itemId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      // API keys subcollection
      match /keys/{keyId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(keyId) && incoming().userId == userId;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(keyId);
      }
    }
  }
}
