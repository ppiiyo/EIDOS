{
  "name": "eidos/bitrix-connector",
  "description": "Isolated 1C-Bitrix Hybrid Search & Recommendations Connector for EIDOS Engine v1.0",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Eidos\\Connectors\\Core\\": "../core/src/",
      "Eidos\\Connectors\\Bitrix\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eidos\\Connectors\\Core\\TestSuite\\": "../core/test-suite/",
      "Eidos\\Connectors\\Bitrix\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always tests/ConnectorTest.php"
  }
}
