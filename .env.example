# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Eidos Core & Server Configuration
NODE_ENV=development
PORT=8080
EIDOS_API_KEY=your_secret_key
EIDOS_MASTER_KEY=your_master_admin_key
EIDOS_PUBLIC_DEMO_KEY=eidos_public_demo_key_2026
JWT_SECRET=your_jwt_signing_secret

# HNSW Vector Engine & Sharding Parameters
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=64
HNSW_USE_QUANTIZATION=true
RERANKER_ENABLED=true
RERANKER_GAMMA=0.65

# Semantic & Redis Cache Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=300
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_MAX_ENTRIES=1000

# Database Connectors (PostgreSQL / MongoDB)
DATABASE_URL=postgresql://eidos:eidos_prod_password@localhost:5432/eidos
POSTGRES_USER=eidos
POSTGRES_PASSWORD=eidos_prod_password
POSTGRES_DB=eidos
POSTGRES_PORT=5432
MONGODB_URI=mongodb://localhost:27017/eidos

# Rate Limiting & Security
RATE_LIMIT_MAX_RPM=600
RATE_LIMIT_BURST=100
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Adaptive Intelligence Layer (AIL)
AIL_ENABLED=false
AIL_ALPHA=0.45
AIL_BETA=0.15
AIL_GAMMA=0.10
AIL_DELTA=0.20
AIL_EPSILON=0.05
AIL_ZETA=0.03
AIL_ETA=0.02
AIL_SMMR_LAMBDA=0.7
AIL_SMMR_SAMPLE_SIZE=10
AIL_SMMR_TEMPERATURE=0.5
AIL_USER_HISTORY_MAX=50
AIL_USER_RECENCY_DECAY=0.95
AIL_FEEDBACK_LEARNING_RATE=0.01

# Observability (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=eidos_admin_2026
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
