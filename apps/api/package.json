{
  "name": "@eidos/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"const fs=require('fs');if(!fs.existsSync('../../packages/core/dist/index.d.ts'))require('child_process').execSync('npx tsc -p ../../packages/core/tsconfig.json',{stdio:'inherit'})\" && tsc",
    "lint": "node -e \"const fs=require('fs');if(!fs.existsSync('../../packages/core/dist/index.d.ts'))require('child_process').execSync('npx tsc -p ../../packages/core/tsconfig.json --emitDeclarationOnly',{stdio:'inherit'})\" && tsc --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run --config ../../vitest.config.ts apps/api/tests"
  },
  "dependencies": {
    "@eidos/core": "file:../../packages/core",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@xenova/transformers": "^2.17.2",
    "fastify": "^4.26.2",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^2.1.8"
  }
}
