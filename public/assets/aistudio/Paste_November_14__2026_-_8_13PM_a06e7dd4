Ts
import fp from 'fastify-plugin';
import fastifyStatic from '@fastify/static';
import compress from '@fastify/compress';
import * as fs from 'fs';
import * as path from 'path';

function resolveDistDir(): string | null {
  const candidates = [
    process.env.EIDOS_STATIC_DIR,
    path.resolve(process.cwd(), 'dist'),
    path.resolve(process.cwd(), 'apps/workspace/dist'),
  ].filter(Boolean) as string[];
  return candidates.find((d) => fs.existsSync(path.join(d, 'index.html'))) ?? null;
}

export const staticSpaPlugin = fp(async (fastify) => {
  const dist = resolveDistDir();
  if (!dist) { fastify.log.warn('[EIDOS] SPA dist not found — UI disabled'); return; }
  await fastify.register(compress, { encodings: ['br', 'gzip'] });
  await fastify.register(fastifyStatic, {
    root: dist,
    wildcard: false,
    setHeaders(res, filePath) {
      const rel = path.relative(dist, filePath).replace(/\\/g, '/');
      if (rel.startsWith('assets/')) res.setHeader('Cache-Control', 'public, max-age=31536000, immutable');
      else if (rel.endsWith('.html') || rel === 'widget.js') res.setHeader('Cache-Control', 'no-cache');
      if (filePath.endsWith('.wasm')) res.setHeader('Content-Type', 'application/wasm');
    },
  });
  // SPA-fallback только для путей без расширения; отсутствующий ассет — честный 404
  fastify.setNotFoundHandler((req, reply) => {
    const p = req.url.split('?')[0];
    const hasExt = path.extname(p) !== '';
    if ((req.method === 'GET' || req.method === 'HEAD') && !hasExt && !p.startsWith('/v1/') && p !== '/metrics') {
      return reply.type('text/html').sendFile('index.html');
    }
    return reply.status(404).send({ statusCode: 404, error: 'Not Found' });
  });
});
