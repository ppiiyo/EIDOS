function parsePort(raw: string | undefined, source: string): number | null {
  if (!raw) return null;
  const n = Number(raw);
  if (!Number.isInteger(n) || n < 1 || n > 65535) {
    console.error(`[EIDOS] Invalid port "${raw}" from ${source}; ignoring`);
    return null;
  }
  return n;
}
function resolvePort(): number {
  const i = process.argv.indexOf('--port');
  if (i !== -1) { const p = parsePort(process.argv[i + 1], '--port'); if (p) return p; }
  return parsePort(process.env.EIDOS_PORT, 'EIDOS_PORT')
      ?? parsePort(process.env.DEFAULT_APP_PORT, 'DEFAULT_APP_PORT')
      ?? (process.env.PORT !== process.env.NGINX_PORT ? parsePort(process.env.PORT, 'PORT') : null)
      ?? 3000;
}
