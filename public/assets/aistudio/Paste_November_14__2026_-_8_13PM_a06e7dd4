8.1. Если yml-parser.ts всё ещё regex — замени на sax (pnpm --filter @eidos/api add sax), стриминг:

Ts
import sax from 'sax';
export function parseYmlStream(stream: NodeJS.ReadableStream, onOffer: (o: CatalogItem) => void): Promise<void> {
  return new Promise((resolve, reject) => {
    const s = sax.createStream(true, { trim: true });
    let cur: any = null, tag = '', text = '';
    s.on('opentag', (n: any) => { tag = n.name; text = ''; if (n.name === 'offer') cur = { id: n.attributes.id, available: n.attributes.available === 'true', params: {} }; });
    s.on('text', (t) => { text += t; }); s.on('cdata', (t) => { text += t; });
    s.on('closetag', (name) => {
      if (!cur) return;
      if (name === 'offer') { onOffer(mapOffer(cur)); cur = null; return; }
      if (['name','vendor','model','description','price','currencyId','categoryId','vendorCode','picture'].includes(name)) cur[name] = text;
      if (name === 'param') cur.params[text] = true;
    });
    s.on('end', resolve); s.on('error', reject); stream.pipe(s);
  });
}
Сохрани SSRF-обёртку safe-fetch и лимит размера. Тесты: &#1089;, CDATA, вложенные param, разный порядок атрибутов; битый XML → ошибка со строкой.

