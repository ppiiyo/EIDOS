R5. Снапшоты v2 по умолчанию + атомарная пара + манифест
Сделай NDJSON дефолтом (EIDOS_SNAPSHOT_FORMAT по умолчанию 'ndjson'; legacy JSON только при явном =json). Новый модуль apps/api/src/services/snapshot-io.ts:

Ts
import * as fs from 'fs'; import * as path from 'path'; import * as crypto from 'crypto';
export interface SnapshotManifest {
  formatVersion: 2; createdAt: string; itemCount: number;
  embeddingSpaceId: string; catalogVersion: number;
  files: { items: { name: string; sha256: string }; hnsw: { name: string; sha256: string } };
}
const sha = (b: Buffer) => crypto.createHash('sha256').update(b).digest('hex');

export function writeSnapshotPairSync(basePath: string, items: Iterable<Record<string, unknown>>,
  hnsw: Uint8Array, meta: { embeddingSpaceId: string; catalogVersion: number; itemCount: number }): void {
  const dir = path.dirname(basePath), stem = path.basename(basePath);
  const tmp = path.join(dir, `.snap-tmp-${process.pid}-${Date.now()}`);
  fs.mkdirSync(tmp, { recursive: true });
  const fd = fs.openSync(path.join(tmp, 'items.ndjson'), 'w');
  const h = crypto.createHash('sha256'); let count = 0;
  try { for (const it of items) { const line = Buffer.from(JSON.stringify(it) + '\n'); fs.writeSync(fd, line); h.update(line); count++; } }
  finally { fs.closeSync(fd); }
  if (count !== meta.itemCount) throw new Error(`snapshot count mismatch ${count}!=${meta.itemCount}`);
  fs.writeFileSync(path.join(tmp, 'hnsw.bin'), hnsw);
  const manifest: SnapshotManifest = {
    formatVersion: 2, createdAt: new Date().toISOString(), itemCount: count,
    embeddingSpaceId: meta.embeddingSpaceId, catalogVersion: meta.catalogVersion,
    files: { items: { name: 'items.ndjson', sha256: h.digest('hex') }, hnsw: { name: 'hnsw.bin', sha256: sha(Buffer.from(hnsw)) } },
  };
  fs.writeFileSync(path.join(tmp, 'manifest.json'), JSON.stringify(manifest));
  for (const n of ['items.ndjson', 'hnsw.bin']) fs.renameSync(path.join(tmp, n), path.join(dir, `${stem}.${n}`));
  fs.renameSync(path.join(tmp, 'manifest.json'), `${basePath}.manifest.json`); // маркер завершённости — последним
  fs.rmSync(tmp, { recursive: true, force: true });
}

export function readSnapshotPairSync(basePath: string) {
  const mp = `${basePath}.manifest.json`;
  if (!fs.existsSync(mp)) return null; // legacy-путь
  const manifest = JSON.parse(fs.readFileSync(mp, 'utf8')) as SnapshotManifest;
  const dir = path.dirname(basePath), stem = path.basename(basePath);
  const itemsBuf = fs.readFileSync(path.join(dir, `${stem}.${manifest.files.items.name}`));
  const hnsw = fs.readFileSync(path.join(dir, `${stem}.${manifest.files.hnsw.name}`));
  if (sha(itemsBuf) !== manifest.files.items.sha256 || sha(hnsw) !== manifest.files.hnsw.sha256)
    throw new Error('[EIDOS] Snapshot integrity FAILED (sha256) — refusing to load');
  const items: Record<string, unknown>[] = []; let start = 0;
  for (let i = 0; i < itemsBuf.length; i++) if (itemsBuf[i] === 0x0a) {
    if (i > start) items.push(JSON.parse(itemsBuf.toString('utf8', start, i))); start = i + 1;
  }
  if (items.length !== manifest.itemCount) throw new Error('[EIDOS] Snapshot item count mismatch');
  return { items, hnsw, manifest };
}
