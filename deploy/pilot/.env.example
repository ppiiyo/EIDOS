# ==============================================================================
# EIDOS v3.4 Pilot Stack Configuration (deploy/pilot/.env.example)
# ==============================================================================
PORT=3001
NODE_ENV=production
DATA_DIR=/var/lib/eidos

# Distinct cryptographic keys (auto-generated by deploy/pilot/install.sh)
ADMIN_KEY=eidos_adm_replace_with_32_byte_hex_secret_key_for_admin_ops
SEARCH_KEY=eidos_pub_replace_with_32_byte_hex_secret_key_for_storefront
EIDOS_MASTER_KEY=eidos_adm_replace_with_32_byte_hex_secret_key_for_admin_ops
EIDOS_ADMIN_KEY=eidos_adm_replace_with_32_byte_hex_secret_key_for_admin_ops
EIDOS_SEARCH_KEY=eidos_pub_replace_with_32_byte_hex_secret_key_for_storefront

# Fail-closed empty index protection (returns 503 INDEX_EMPTY so CMS falls back)
EIDOS_FAIL_CLOSED_EMPTY_INDEX=true
LOG_SUGGEST_RATE=0.2

# CORS Origin (set to your storefront domain in production)
CORS_ORIGIN=*
REDIS_URL=redis://redis:6379
